+	CREATE_TEMP_FILE(3)
+	CREATE_TEMP_FILE(4)
+	CREATE_TEMP_FILE(5)
+	CREATE_TEMP_FILE(6)
+	CREATE_TEMP_FILE(7)
+	CREATE_TEMP_FILE(8)
+	CREATE_TEMP_FILE(9)
+	CREATE_TEMP_FILE(10)
+	CREATE_TEMP_FILE(11)
+}
+
+static void huawei_wmi_temp_exit(struct device *dev)
+{
+	struct huawei_wmi *huawei = dev_get_drvdata(dev);
+
+	if (huawei->temp_available)
+	{
+		REMOVE_TEMP_FILE(1)
+		REMOVE_TEMP_FILE(2)
+		REMOVE_TEMP_FILE(3)
+		REMOVE_TEMP_FILE(4)
+		REMOVE_TEMP_FILE(5)
+		REMOVE_TEMP_FILE(6)
+		REMOVE_TEMP_FILE(7)
+		REMOVE_TEMP_FILE(8)
+		REMOVE_TEMP_FILE(9)
+		REMOVE_TEMP_FILE(10)
+		REMOVE_TEMP_FILE(11)
+	}
+}
